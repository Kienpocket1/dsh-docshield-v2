{
  "name": "dsh-gate",
  "version": "0.1.0",
  "private": true,
  "description": "dsh-gate: plugin DSH bật cổng đăng nhập + lọc theo người dùng đứng trước một DSH dùng chung.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "dsh-gate": "bin/gate.mjs"
  },
  "scripts": {
    "start": "node bin/gate.mjs serve",
    "test": "node --test test/*.test.mjs"
  },
  "main": "./plugin/index.mjs",
  "exports": {
    ".": "./plugin/index.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    }
  }
}
